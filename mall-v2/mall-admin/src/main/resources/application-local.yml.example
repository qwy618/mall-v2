# 复制为 application-local.yml（同目录）后填写你的真实配置。
# application-local.yml 已在 .gitignore 中，不会被提交。
server:
  port: 8080

spring:
  datasource:
    # host/port/username 一般不用改，这里覆盖密码
    password: your-mysql-password
  rabbitmq:
    host: 127.0.0.1
    password: guest
  data:
    redis:
      host: 127.0.0.1
      password:

jwt:
  # HS256 要求 ≥ 32 字节，请替换为随机强密钥
  secret: please-change-to-a-random-32-bytes-secret

oss:
  # 阿里云 OSS（图片上传用），没有可留空
  access-key-id:
  access-key-secret:
  bucket:
  base-url:

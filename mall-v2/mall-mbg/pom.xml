<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.macro.mall</groupId>
        <artifactId>mall-v2</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mall-mbg</artifactId>
    <packaging>jar</packaging>
    <name>mall-mbg</name>
    <description>数据访问模块：entity + mapper。依赖 common，被 admin / portal 依赖</description>

    <dependencies>
        <dependency>
            <groupId>com.macro.mall</groupId>
            <artifactId>mall-common</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter，版本在父工程管理） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动：版本由 spring-boot-starter-parent 托管，不写 version -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
              坑位：放在 src/main/java 下的 xml 默认不会被打包
              本模块把 mapper.xml 统一放 resources/mapper 下，所以只需这行放开过滤即可
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

</project>

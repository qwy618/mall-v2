# DeepSeek API Key —— 在 https://platform.deepseek.com 创建
# 复制本文件为 .env 并填入真实 Key（.env 已被 gitignore，不会提交）
# 也可直接配置系统环境变量 DEEPSEEK_API_KEY（系统变量优先级更高）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# mall-v2 portal 地址（唯一后端依赖；ES 已内置进 portal）
PORTAL_BASE_URL=http://localhost:8081

# 状态层（M1）：会话历史 / 订单草稿 / 幂等结果缓存
# 用独立 db（建议 5）与 portal 的 db0 隔离；有密码写成 redis://:密码@host:6379/5
REDIS_URL=redis://localhost:6379/5

# 向量库（M3）：Qdrant server 模式（独立进程，多 worker 共享同一份索引）
# 起容器：docker run -d --name qdrant -p 6333:6333 -v /data/qdrant:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://192.168.150.128:6333
# Embedding（fastembed + bge-small-zh-v1.5，512 维，走 ONNX 无需 PyTorch）
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_CACHE_DIR=./data/fastembed

# 检索与索引（M3）
# 一键回退开关：置 0 后 search_knowledge 直接返回"暂无信息"，索引坏了也不影响其余工具
RAG_ENABLED=1
# 相似度阈值：按 M3.5 金标集（28 条）复标为 0.48，见 eval/baseline.json。
# 复标命令：python scripts/eval_golden.py（会打印安全区间与阈值敏感度代价表）
RAG_SIM_THRESHOLD=0.48
# 定时增量索引（M3.3）：低峰全量重建；多 worker 下靠 ai:rag:lock 保证只跑一次
RAG_INDEX_CRON=0 3 * * *
# 启动自检：索引缺失/指纹不符（换过 embedding 模型或维度）时，后台自动建一次
RAG_INDEX_ON_START=0

# 会话裁剪：条数上限 + 上下文估算 token 预算（超出则整组丢弃更早的消息）
SESSION_MAX_MESSAGES=48
SESSION_TOKEN_BUDGET=6000
